 */\n.lp-industry-bar {\n  background: rgba(6, 12, 26, 0.88);\n  border-top: 1px solid rgba(255, 255, 255, 0.07);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.07);\n}\n\n.lp-industry-inner {\n  display: flex;\n  align-items: stretch;\n  justify-content: center;\n  min-height: 72px;\n  overflow-x: auto;\n}\n\n.lp-industry-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--lp-muted);\n  padding: 0 34px;\n  cursor: default;\n  white-space: nowrap;\n  transition: color var(--lp-tr), background var(--lp-tr);\n  border-right: 1px solid rgba(255, 255, 255, 0.07);\n}\n\n.lp-industry-item:first-child {\n  border-left: 1px solid rgba(255, 255, 255, 0.07);\n}\n\n.lp-industry-item:hover {\n  color: #fff;\n  background: rgba(255, 255, 255, 0.04);\n}\n\n.lp-ind-icon {\n  color: var(--lp-cyan);\n  opacity: 0.75;\n  transition: opacity var(--lp-tr), transform var(--lp-tr);\n}\n\n.lp-industry-item:hover .lp-ind-icon {\n  opacity: 1;\n  transform: scale(1.1);\n}\n\n/* ═══════════════════════════════════════════════════════════════\n   7. FOOTER SECTION\n   ═══════════════════════════════════════════════════════════════ */\n.lp-footer {\n  background: var(--lp-bg-dark);\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  padding: 64px 48px 28px;\n}\n\n.lp-footer-top {\n  display: grid;\n  grid-template-columns: 1.8fr 1fr 1fr 1.6fr;\n  gap: 44px;\n  margin-bottom: 48px;\n  max-width: 1280px;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.lp-footer-brand {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.lp-footer-brand-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.lp-footer-name {\n  font-size: 17px;\n  font-weight: 800;\n  color: #fff;\n  margin: 0;\n  line-height: 1.1;\n}\n\n.lp-footer-sub {\n  font-size: 8.5px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  color: var(--lp-cyan);\n  opacity: 0.85;\n  margin: 0;\n}\n\n.lp-footer-tagline {\n  font-size: 13px;\n
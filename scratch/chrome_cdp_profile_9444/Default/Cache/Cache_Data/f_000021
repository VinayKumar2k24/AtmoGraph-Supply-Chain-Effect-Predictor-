55, 255, 0.07);\n  font-size: 12px;\n  color: var(--lp-dim);\n  max-width: 1280px;\n  margin: 0 auto;\n}\n\n.lp-footer-slogan {\n  color: var(--lp-dim);\n}\n\n/* ═══════════════════════════════════════════════════════════════\n   INTERACTIVE MODALS\n   ═══════════════════════════════════════════════════════════════ */\n.lp-modal-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  background: rgba(3, 6, 15, 0.85);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  animation: lp-fade-in 0.2s ease-out;\n}\n\n.lp-modal-dialog {\n  position: relative;\n  width: 100%;\n  max-width: 780px;\n  max-height: 90vh;\n  overflow-y: auto;\n  background: #081024;\n  border: 1px solid rgba(0, 229, 255, 0.35);\n  border-radius: 20px;\n  padding: 36px 38px;\n  box-shadow: 0 24px 72px rgba(0, 0, 0, 0.8), 0 0 36px rgba(0, 229, 255, 0.18);\n  animation: lp-modal-scale 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n@keyframes lp-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes lp-modal-scale {\n  from { opacity: 0; transform: scale(0.94); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n.lp-modal-close {\n  position: absolute;\n  top: 20px;\n  right: 20px;\n  background: rgba(255, 255, 255, 0.06);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #fff;\n  border-radius: 50%;\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all var(--lp-tr);\n}\n\n.lp-modal-close:hover {\n  background: rgba(239, 68, 68, 0.2);\n  border-color: #ef4444;\n  color: #ef4444;\n}\n\n.lp-modal-header {\n  margin-bottom: 24px;\n}\n\n.lp-modal-title {\n  font-size: 24px;\n  font-weight: 800;\n  color: #fff;\n  margin: 14px 0 8px;\n  line-height: 1.2;\n}\n\n.lp-modal-subtitle {\n  font-size: 14px;\n  color: var(--lp-muted);\n  line-height: 1.6;\n  margin: 0;\n}\n\n.lp-modal-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n  margin: 24px 0;\n}\n\n.lp-modal-feature {\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid var(--lp-border);\n  border-radius: 12px;\n  padding: 18px;\n}\n\n.lp-modal-feat-icon {\n  margin-bottom: 10px;\n}\n\n.lp-modal-feature h4 {\n  font-size: 14.5px;\n  font-weight: 700;\n  color: #fff;\n  margin: 0 0 6px;\n}\n\n.lp-modal-feature p {\n  font-size: 12.5px;\n  color: var(--lp-muted);\n  line-height: 1.6;\n  margin: 0;\n}\n\n.lp-modal-footer {\n  margin-top: 28px;\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n}\n\n/* Pipeline Step Cards */\n.lp-pipeline-steps {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin: 20px 0;\n}\n\n.lp-step-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 16px;\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid var(--lp-border);\n  border-radius: 12px;\n  padding: 14px 18px;\n}\n\n.lp-step-num {\n  font-size: 14px;\n  font-weight: 800;\n  color: var(--lp-cyan);\n  background: rgba(0, 229, 255, 0.1);\n  border: 1px solid rgba(0, 229, 255, 0.25);\n  border-radius: 6px;\n  padding: 4px 8px;\n  flex-shrink: 0;\n}\n\n.lp-step-info h4 {\n  font-size: 14px;\n  font-weight: 700;\n  color: #fff;\n  margin: 0 0 4px;\n}\n\n.lp-step-info p {\n  font-size: 12.5px;\n  color: var(--lp-muted);\n  line-height: 1.55;\n  margin: 0;\n}\n\n/* Scenario Modal Box */\n.lp-scenario-modal-box {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  margin: 20px 0;\n}\n\n.lp-scen-news {\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid var(--lp-border);\n  border-radius: 14px;\n  padding: 18px 20px;\n}\n\n.lp-scen-tag {\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  color: var(--lp-cyan);\n  margin-bottom: 8px;\n  display: block;\n}\n\n.lp-scen-news h4 {\n  font-size: 15px;\n  font-weight: 700;\n  color: #fff;\n  margin: 0 0 8px;\n}\n\n.lp-scen-news p {\n  font-size: 13px;\n  color: var(--lp-muted);\n  line-height: 1.6;\n  font-style: italic;\n  margin: 0 0 14px;\n}\n\n.lp-scen-entities {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.lp-ent-pill {\n  font-size: 11px;\n  font-weight: 700;\n  padding: 4px 10px;\n  border-radius: 999px;\n}\n\n.lp-ent-pill--origin {\n  background: rgba(239, 68, 68, 0.15);\n  color: #f87171;\n  border: 1px solid rgba(239, 68, 68, 0.3);\n}\n\n.lp-ent-pill--supplier {\n  background: rgba(0, 229, 255, 0.15);\n  color: #38bdf8;\n  border: 1px solid rgba(0, 229, 255, 0.3);\n}\n\n.lp-ent-pill--cascade {\n  background: rgba(245, 158, 11, 0.15);\n  color: #fbbf24;\n  border: 1px solid rgba(245, 158, 11, 0.3);\n}\n\n.lp-scen-cascade {\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid var(--lp-border);\n  border-radius: 14px;\n  padding: 18px 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.lp-cascade-step {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 13px;\n  color: #e2e8f0;\n}\n\n.lp-cascade-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.lp-cascade-dot.red { background: #ef4444; box-shadow: 0 0 8px #ef4444; }\n.lp-cascade-dot.orange { background: #f59e0b; box-shadow: 0 0 8px #f59e0b; }\n.lp-cascade-dot.blue { background: #38bdf8; box-shadow: 0 0 8px #38bdf8; }\n.lp-cascade-dot.green { background: #22c55e; box-shadow: 0 0 8px #22c55e; }\n\n.lp-badge {\n  font-size: 10.5px;\n  font-weight: 700;\n  padding: 2px 8px;\n  border-radius: 999px;\n  margin-left: 8px;\n}\n\n.risk-crit { background: rgba(239, 68, 68, 0.18); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }\n.risk-high { background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }\n.risk-ok   { background: rgba(34, 197, 94, 0.18); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }\n\n/* About Text */\n.lp-about-text {\n  font-size: 14px;\n  color: var(--lp-muted);\n  line-height: 1.7;\n}\n\n.lp-about-bullets {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-top: 18px;\n}\n\n.lp-about-bullet {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  color: #e2e8f0;\n}\n\n/* ═══════════════════════════════════════════════════════════════\n   RESPONSIVE DESIGN (LAPTOP & MOBILE)\n   ═══════════════════════════════════════════════════════════════ */\n@media (max-width: 1200px) {\n  .lp-nav { padding: 0 28px; }\n  .lp-hero-left { padding: 40px 28px; }\n  .lp-stats-wrap { padding: 0 28px; }\n  .lp-sol-grid { grid-template-columns: repeat(2, 1fr); }\n  .lp-section { padding: 76px 28px; }\n  .lp-cta-wrapper { padding: 0 28px 76px; }\n  .lp-cta-content { padding: 56px 44px; gap: 36px; }\n  .lp-footer { padding: 52px 28px 24px; }\n  .lp-footer-top { grid-template-columns: 1fr 1fr; }\n}\n\n@media (max-width: 960px) {\n  .lp-hero {\n    grid-template-columns: 1fr;\n    max-height: none;\n    min-height: auto;\n  }\n  .lp-hero-right {\n    height: 380px;\n  }\n  .lp-hero-left {\n    padding: 44px 24px 32px;\n  }\n  .lp-nav-links {\n    display: none;\n  }\n  .lp-nav-actions {\n    display: none;\n  }\n  .lp-burger {\n    display: flex;\n  }\n  .lp-cta-content {\n    grid-template-columns: 1fr;\n  }\n  .lp-quote-card {\n    display: none;\n  }\n  .lp-industry-inner {\n    justify-content: flex-start;\n  }\n  .lp-industry-item {\n    padding: 0 24px;\n  }\n}\n\n@media (max-width: 640px) {\n  .lp-nav { padding: 0 16px; }\n  .lp-hero-left { padding: 32px 18px 24px; gap: 20px; }\n  .lp-hero-right { height: 300px; }\n  .lp-hero-ctas { flex-direction: column; align-items: flex-start; width: 100%; }\n  .lp-hero-ctas .lp-cta-btn,\n  .lp-hero-ctas .lp-outline-btn { width: 100%; }\n  .lp-stats-wrap { padding: 0 16px; }\n  .lp-stats-bar { flex-direction: column; border-radius: 14px; }\n  .lp-stat-cell { padding: 18px 20px; }\n  .lp-stat-sep { display: none; }\n  .lp-sol-grid { grid-template-columns: 1fr; }\n  .lp-section { padding: 5
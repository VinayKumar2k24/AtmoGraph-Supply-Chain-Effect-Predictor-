(99, 102, 241, 0.4);\r\n  color: #818cf8;\r\n}\r\n\r\n/* =====================================================\r\n   NODE DETAILS PANEL\r\n   ===================================================== */\r\n.details-panel {\r\n  background: var(--bg-surface);\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow-y: auto;\r\n}\r\n\r\n.details-panel-header {\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.details-panel-title {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: #f1f5f9;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.8px;\r\n}\r\n\r\n.details-close-btn {\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 4px;\r\n  border-radius: 4px;\r\n  transition: all var(--transition-fast);\r\n}\r\n\r\n.details-close-btn:hover {\r\n  background: rgba(255, 255, 255, 0.06);\r\n  color: var(--text-primary);\r\n}\r\n\r\n.details-empty {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  padding: var(--space-6);\r\n  text-align: center;\r\n}\r\n\r\n.details-empty-icon {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: var(--radius-xl);\r\n  background: var(--bg-card);\r\n  border: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--accent-primary-light);\r\n}\r\n\r\n.details-empty-title {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #e2e8f0;\r\n}\r\n\r\n.details-empty-text {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  line-height: 1.5;\r\n}\r\n\r\n.details-content {\r\n  padding: var(--space-4);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n\r\n.details-